{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "color": {
        "1": "red",
        "2": "red"
      },
      "source": "~/.config/fastfetch/aperture.txt"
    },
    "modules": [
	    "break",
      {
        "type": "title",
        "key": "User",
        "keyColor": "red",
        "format": "{user-name}",
        "outputColor": "default"
      },
      {
        "type": "host",
        "key": "Host",
        "format": "Hostname",
        "keyColor": "red"
      },
      "break",
      {
        "type": "os",
        "key": "OS",
        "keyColor": "red"  // = color3
      },
      {
        "type": "kernel",
        "key": "Kernel",
        "keyColor": "red"
      },
      {
        "type": "uptime",
        "key": "Uptime",
        "keyColor": "red"
      },
      "break",
      {
        "type": "cpu",
        "key": "CPU",
        "keyColor": "red",
        "temp": true
      },
      {
        "type": "gpu",
        "key": "GPU",
        "keyColor": "red"
      },
      {
        "type": "memory",
        "key": "Memory",
        "keyColor": "red"
      },
      "break",
      {
        "type": "disk",
        "key": "Disk (/)",
        "keyColor": "red"
      },
      {
        "type": "packages",
        "key": "Packages",
        "keyColor": "red"  
      },
      "break"
    ]
}

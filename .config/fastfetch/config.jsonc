{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "~/.config/fastfetch/aperture.txt"
    },
    "modules": [
	    "break",
      {
        "type": "title",
        "key": "User",
        "format": "{user-name}",
        "outputColor": "default"
      },
      {
        "type": "host",
        "key": "Host",
        "format": "Hostname",
      },
      "break",
      {
        "type": "os",
        "key": "OS",
      },
      {
        "type": "kernel",
        "key": "Kernel",
      },
      {
        "type": "uptime",
        "key": "Uptime",
      },
      "break",
      {
        "type": "cpu",
        "key": "CPU",
        "temp": true
      },
      {
        "type": "gpu",
        "key": "GPU",
      },
      {
        "type": "memory",
        "key": "Memory",
      },
      "break",
      {
        "type": "disk",
        "key": "Disk (/)",
      },
      {
        "type": "packages",
        "key": "Packages",
      },
      "break"
    ]
}
